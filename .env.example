# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_BASE_URL=https://openrouter.ai/api/v1
VITE_USE_OPENAI_FALLBACK=false

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Pinata IPFS Configuration
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# Application Configuration
VITE_APP_NAME=ClaimSnap AI
VITE_APP_URL=https://claimsnap.ai
VITE_APP_ENVIRONMENT=development # development, staging, production
